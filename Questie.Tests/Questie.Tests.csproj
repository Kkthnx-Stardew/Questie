<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- These files have no game dependencies, so the tests compile them directly. -->
    <Compile Include="..\Questie\ModConfig.cs" Link="ModConfig.cs" />
    <Compile Include="..\Questie\QuestFact.cs" Link="QuestFact.cs" />
    <Compile Include="..\Questie\MarkerPlan.cs" Link="MarkerPlan.cs" />
    <Compile Include="..\Questie\FishTimes.cs" Link="FishTimes.cs" />
    <Compile Include="..\Questie\HintBuilder.cs" Link="HintBuilder.cs" />
    <Compile Include="..\Questie\SocializeRepair.cs" Link="SocializeRepair.cs" />
    <Compile Include="..\Questie\DonationLines.cs" Link="DonationLines.cs" />
    <Compile Include="..\Questie\ItemNeeds.cs" Link="ItemNeeds.cs" />
  </ItemGroup>

</Project>
